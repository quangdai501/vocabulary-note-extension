{
  "name": "vocabulary-note-extension",
  "version": "1.0.0",
  "description": "Vocabulary learning extension with React options page",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:ui && npm run build:content",
    "build:ui": "vite build",
    "build:content": "vite build --config vite.content.config.js",
    "preview": "vite preview",
    "mobile:install": "npm --prefix mobile install",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "shared-core:test": "npm --prefix packages/shared-core run test",
    "functions:install": "npm --prefix functions install",
    "functions:build": "npm --prefix functions run build",
    "emulators:start": "firebase emulators:start --only firestore,functions",
    "verify:word-trigger": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/verify-word-trigger.js"
  },
  "dependencies": {
    "firebase": "^12.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^5.1.0"
  }
}
